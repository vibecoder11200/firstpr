#!/bin/sh
# commit-msg hook: enforce FirstPR commit rules (see CLAUDE.md).
#
# Hard fails:
#   1. Conventional Commits format: `type(scope): summary`
#      types: feat | fix | docs | refactor | perf | test | build | ci | chore | style | i18n
#   2. Attribution trailers — Co-Authored-By, Signed-off-by, "Generated with", etc.
#
# Warning (non-blocking):
#   3. Missing body/description (encouraged, not mandatory — trivial commits may skip).
#
# Escape hatch for exceptional cases: `git commit --no-verify`.

MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Strip git's editor comment lines (# ...)
msg=$(sed '/^#/d' "$MSG_FILE")

# 1. Conventional commit subject -------------------------------------------------
subject=$(printf '%s\n' "$msg" | sed -n '1p' | sed 's/[[:space:]]*$//')

if ! printf '%s\n' "$subject" | grep -Eq \
  '^(feat|fix|docs|refactor|perf|test|build|ci|chore|style|i18n)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "ERROR: commit subject must follow Conventional Commits: type(scope): summary"
  echo "  types: feat | fix | docs | refactor | perf | test | build | ci | chore | style | i18n"
  echo "  example: docs: document the scoring model criteria"
  exit 1
fi

# 2. Attribution trailers ----------------------------------------------------------
if printf '%s\n' "$msg" | grep -Ein \
  '^(co-authored-by|co-developed-by|signed-off-by|reviewed-by|generated with|generated by)' \
  > /dev/null 2>&1; then
  echo "ERROR: commit must NOT contain attribution trailers"
  echo "  blocked: Co-Authored-By, Co-Developed-By, Signed-off-by, Reviewed-by, 'Generated with', 'Generated by'"
  echo "  remove these lines and re-commit."
  exit 1
fi

# 3. Body encouraged (non-blocking) -------------------------------------------------
line_count=$(printf '%s\n' "$msg" | grep -c '[^[:space:]]')
if [ "$line_count" -lt 2 ]; then
  echo "WARNING: no commit description (body). Add what changed and why for non-trivial commits."
fi

exit 0
