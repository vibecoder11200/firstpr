# ======================================================================
# FirstPR — environment template
# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# The app refuses to start if required vars are missing.
# ======================================================================

# --- Timestamps / formatting ---
CK_PLAN_DATE_FORMAT=YYYY-MM-DD

# --- HTTP ---
API_PORT=4000
WEB_PORT=3000
# The public base URL for the API (used for OAuth redirect + cookies).
# Local: http://localhost:4000  |  Prod: https://api.firstpr.cc
PUBLIC_API_URL=http://localhost:4000
# The public base URL for the SPA (trusted origin for Better Auth).
PUBLIC_APP_URL=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgres://firstpr:firstpr@localhost:5432/firstpr

# --- Redis (worker queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-better-auth-secret

# --- GitHub OAuth App ---
# Scope: read:user + user:email (+ public_repo for portfolio reads). NO `repo`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# For GitHub App installation tokens (optional; falls back to OAuth user tokens).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Analytics (PostHog) ---
# Leave blank to disable tracking in local dev.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Worker jobs ---
# How fresh repo metrics must be before a re-score is skipped (hours).
SCORE_MAX_AGE_HOURS=24